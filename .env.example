# ============================================================
# OpenAI API Configuration
# ============================================================
# 1. Get your API key from: https://platform.openai.com/api-keys
# 2. Copy this file to .env: copy .env.example .env  (or cp .env.example .env)
# 3. Paste your real API key below (do not commit .env to version control!)

OPENAI_API_KEY=your_openai_api_key_here

# Optional: LLM Model selection (defaults to gpt-4o-mini)
# Available models include: gpt-4o-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# Optional: Custom system prompt instructions for the chatbot
SYSTEM_PROMPT=You are a helpful, friendly, and intelligent AI assistant.
